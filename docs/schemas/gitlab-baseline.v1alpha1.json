{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baluarte.io/schemas/gitlab-baseline.v1alpha1.json",
  "title": "GitLabBaseline",
  "$defs": {
    "AccessTokensRule": {
      "additionalProperties": false,
      "description": "Passes when every active project access token expires within ``max_lifetime_days`` of its\ncreation and, when ``max_unused_days`` is set, was used within that many days.",
      "properties": {
        "id": {
          "description": "Unique within the baseline; named in findings.",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "type": {
          "const": "gitlab.project.access_tokens",
          "title": "Type",
          "type": "string"
        },
        "max_lifetime_days": {
          "maximum": 365,
          "minimum": 1,
          "title": "Max Lifetime Days",
          "type": "integer"
        },
        "max_unused_days": {
          "anyOf": [
            {
              "maximum": 365,
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max Unused Days"
        }
      },
      "required": [
        "id",
        "type",
        "max_lifetime_days"
      ],
      "title": "AccessTokensRule",
      "type": "object"
    },
    "DefaultBranchProtectedRule": {
      "additionalProperties": false,
      "description": "With ``required: true``, passes when the project's default branch is protected.",
      "properties": {
        "id": {
          "description": "Unique within the baseline; named in findings.",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "type": {
          "const": "gitlab.branch.default_protected",
          "title": "Type",
          "type": "string"
        },
        "required": {
          "title": "Required",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "required"
      ],
      "title": "DefaultBranchProtectedRule",
      "type": "object"
    },
    "MergeRequestApprovalsRule": {
      "additionalProperties": false,
      "description": "Passes when the project's own approval rules require at least ``min_approvals`` approvals\non merge requests to its default branch, and its approval settings meet every flag set.",
      "properties": {
        "id": {
          "description": "Unique within the baseline; named in findings.",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "type": {
          "const": "gitlab.project.merge_request_approvals",
          "title": "Type",
          "type": "string"
        },
        "min_approvals": {
          "description": "The largest approvals_required among the regular and any-approver rules that cover the default branch must be at least this.",
          "maximum": 20,
          "minimum": 0,
          "title": "Min Approvals",
          "type": "integer"
        },
        "forbid_author_approval": {
          "default": false,
          "description": "Require merge_requests_author_approval: false.",
          "title": "Forbid Author Approval",
          "type": "boolean"
        },
        "forbid_committer_approval": {
          "default": false,
          "description": "Require merge_requests_disable_committers_approval: true.",
          "title": "Forbid Committer Approval",
          "type": "boolean"
        },
        "reset_approvals_on_push": {
          "default": false,
          "description": "Require reset_approvals_on_push: true.",
          "title": "Reset Approvals On Push",
          "type": "boolean"
        },
        "forbid_override": {
          "default": false,
          "description": "Require disable_overriding_approvers_per_merge_request: true.",
          "title": "Forbid Override",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "min_approvals"
      ],
      "title": "MergeRequestApprovalsRule",
      "type": "object"
    },
    "Metadata": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "description": "Lowercase letters, digits and hyphens; 1 to 63.",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Name",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        }
      },
      "required": [
        "name"
      ],
      "title": "Metadata",
      "type": "object"
    },
    "PrivilegedMembersRule": {
      "additionalProperties": false,
      "description": "Passes when at most ``max_privileged`` members, direct or inherited, hold the Maintainer\nor Owner role on the project.",
      "properties": {
        "id": {
          "description": "Unique within the baseline; named in findings.",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "type": {
          "const": "gitlab.project.privileged_members",
          "title": "Type",
          "type": "string"
        },
        "max_privileged": {
          "maximum": 1000,
          "minimum": 1,
          "title": "Max Privileged",
          "type": "integer"
        },
        "forbid_inactive_accounts": {
          "default": false,
          "description": "Also fail when a member's account is not active (blocked, deactivated or awaiting approval) but still holds access.",
          "title": "Forbid Inactive Accounts",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "max_privileged"
      ],
      "title": "PrivilegedMembersRule",
      "type": "object"
    },
    "ProjectVisibilityRule": {
      "additionalProperties": false,
      "description": "Passes when the project's visibility is one of ``allowed``.",
      "properties": {
        "id": {
          "description": "Unique within the baseline; named in findings.",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "type": {
          "const": "gitlab.project.visibility",
          "title": "Type",
          "type": "string"
        },
        "allowed": {
          "items": {
            "enum": [
              "private",
              "internal",
              "public"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Allowed",
          "type": "array"
        }
      },
      "required": [
        "id",
        "type",
        "allowed"
      ],
      "title": "ProjectVisibilityRule",
      "type": "object"
    },
    "Scope": {
      "additionalProperties": false,
      "properties": {
        "groups": {
          "description": "\"*\" for everything the policy is assigned to, or GitLab group full paths; a path also covers its subgroups. Narrows where an assigned version applies.",
          "items": {
            "maxLength": 1000,
            "pattern": "^(\\*|[A-Za-z0-9_][A-Za-z0-9_.-]{0,254}(/[A-Za-z0-9_][A-Za-z0-9_.-]{0,254}){0,19})$",
            "type": "string"
          },
          "maxItems": 200,
          "minItems": 1,
          "title": "Groups",
          "type": "array"
        }
      },
      "required": [
        "groups"
      ],
      "title": "Scope",
      "type": "object"
    },
    "SecurityPolicyApprovalRule": {
      "additionalProperties": false,
      "description": "Passes when an enabled GitLab approval policy that reaches the project requires at least\n``min_approvals`` approvals on every merge request to its protected branches.",
      "properties": {
        "id": {
          "description": "Unique within the baseline; named in findings.",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "type": {
          "const": "gitlab.security_policy.approval",
          "title": "Type",
          "type": "string"
        },
        "min_approvals": {
          "maximum": 20,
          "minimum": 1,
          "title": "Min Approvals",
          "type": "integer"
        },
        "forbid_author_approval": {
          "default": false,
          "description": "Require approval_settings.prevent_approval_by_author: true.",
          "title": "Forbid Author Approval",
          "type": "boolean"
        },
        "forbid_committer_approval": {
          "default": false,
          "description": "Require approval_settings.prevent_approval_by_commit_author: true.",
          "title": "Forbid Committer Approval",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "min_approvals"
      ],
      "title": "SecurityPolicyApprovalRule",
      "type": "object"
    },
    "SecurityPolicyScanExecutionRule": {
      "additionalProperties": false,
      "description": "Passes when the enabled GitLab scan execution policies that reach the project, taken\ntogether, run every scan in ``scans`` on its default branch.",
      "properties": {
        "id": {
          "description": "Unique within the baseline; named in findings.",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "type": {
          "const": "gitlab.security_policy.scan_execution",
          "title": "Type",
          "type": "string"
        },
        "scans": {
          "items": {
            "enum": [
              "secret_detection",
              "sast",
              "sast_iac",
              "dependency_scanning",
              "container_scanning",
              "dast"
            ],
            "type": "string"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Scans",
          "type": "array"
        },
        "allow_skip_ci": {
          "default": true,
          "description": "When false, a policy that lets pipelines skip it with [skip ci] (skip_ci.allowed: true, GitLab's default) does not count.",
          "title": "Allow Skip Ci",
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "type",
        "scans"
      ],
      "title": "SecurityPolicyScanExecutionRule",
      "type": "object"
    },
    "Spec": {
      "additionalProperties": false,
      "properties": {
        "scope": {
          "$ref": "#/$defs/Scope"
        },
        "rules": {
          "items": {
            "discriminator": {
              "mapping": {
                "gitlab.branch.default_protected": "#/$defs/DefaultBranchProtectedRule",
                "gitlab.group.two_factor_required": "#/$defs/TwoFactorRequiredRule",
                "gitlab.project.access_tokens": "#/$defs/AccessTokensRule",
                "gitlab.project.merge_request_approvals": "#/$defs/MergeRequestApprovalsRule",
                "gitlab.project.privileged_members": "#/$defs/PrivilegedMembersRule",
                "gitlab.project.visibility": "#/$defs/ProjectVisibilityRule",
                "gitlab.security_policy.approval": "#/$defs/SecurityPolicyApprovalRule",
                "gitlab.security_policy.scan_execution": "#/$defs/SecurityPolicyScanExecutionRule"
              },
              "propertyName": "type"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/ProjectVisibilityRule"
              },
              {
                "$ref": "#/$defs/DefaultBranchProtectedRule"
              },
              {
                "$ref": "#/$defs/SecurityPolicyScanExecutionRule"
              },
              {
                "$ref": "#/$defs/SecurityPolicyApprovalRule"
              },
              {
                "$ref": "#/$defs/MergeRequestApprovalsRule"
              },
              {
                "$ref": "#/$defs/PrivilegedMembersRule"
              },
              {
                "$ref": "#/$defs/TwoFactorRequiredRule"
              },
              {
                "$ref": "#/$defs/AccessTokensRule"
              }
            ]
          },
          "maxItems": 100,
          "minItems": 1,
          "title": "Rules",
          "type": "array"
        }
      },
      "required": [
        "scope",
        "rules"
      ],
      "title": "Spec",
      "type": "object"
    },
    "TwoFactorRequiredRule": {
      "additionalProperties": false,
      "description": "Passes when a group above the project, or the instance, requires two-factor\nauthentication of its members.",
      "properties": {
        "id": {
          "description": "Unique within the baseline; named in findings.",
          "pattern": "^[a-z0-9]([a-z0-9-]{0,61}[a-z0-9])?$",
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "default": "medium",
          "enum": [
            "low",
            "medium",
            "high",
            "critical"
          ],
          "title": "Severity",
          "type": "string"
        },
        "description": {
          "anyOf": [
            {
              "maxLength": 1000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Description"
        },
        "type": {
          "const": "gitlab.group.two_factor_required",
          "title": "Type",
          "type": "string"
        },
        "max_grace_hours": {
          "anyOf": [
            {
              "maximum": 720,
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "When set, the shortest grace period among the groups (and instance) that require it must be at most this many hours.",
          "title": "Max Grace Hours"
        }
      },
      "required": [
        "id",
        "type"
      ],
      "title": "TwoFactorRequiredRule",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "apiVersion": {
      "const": "baluarte.io/v1alpha1",
      "title": "Apiversion",
      "type": "string"
    },
    "kind": {
      "const": "GitLabBaseline",
      "title": "Kind",
      "type": "string"
    },
    "metadata": {
      "$ref": "#/$defs/Metadata"
    },
    "spec": {
      "$ref": "#/$defs/Spec"
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "type": "object"
}
